# Anthropic API anahtarı (veya `ant auth login` profili)
ANTHROPIC_API_KEY=

# Modeller: "saglayici:model". Sağlayıcı: anthropic | ollama
# Hızlı katman (sınıflandırma, ön eleme): yerel ve ücretsiz
KYS_MODEL_FAST=ollama:gemma4:latest
# Akıllı katman (kural çıkarımı, çakışma yargısı). Tamamen yerel: ollama:gemma4:31b (yavaş)
KYS_MODEL_SMART=anthropic:claude-sonnet-5-5

# Sorgu servisi (web asistanı) modeli. Claude'a bağımlı değil; bkz. docs/DEPLOY.md
KYS_MODEL_QUERY=anthropic:claude-haiku-5-5
# OpenAI uyumlu sağlayıcılar (GLM, Gemini, Workers AI, OpenRouter...) için:
# KYS_OPENAI_BASE_URL=
# KYS_OPENAI_API_KEY=

# Sorgu servisi erişim anahtarı (bulutta zorunlu tutun)
# KYS_ACCESS_TOKEN=

# Ollama ayarları
# OLLAMA_URL=http://localhost:11434
# KYS_OLLAMA_NUM_CTX=16384
# KYS_OLLAMA_TIMEOUT=900

# Veritabanı yolu. Boş bırakılırsa %LOCALAPPDATA%\kys-agent\kys.db kullanılır.
# SQLite'ı ağ sürücüsüne (W:) koymayın; kilitlenme sorunları çıkar.
# KYS_DB_PATH=
# Zamanlanmış yüklemenin okuduğu klasör (ör. Google Drive senkron klasörü)
# KYS_INBOX_DIR=data/inbox
